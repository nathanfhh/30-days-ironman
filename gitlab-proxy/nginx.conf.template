worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    log_format main '$remote_addr [$time_local] "$request" '
                    '$status $body_bytes_sent '
                    'rt=$request_time';

    access_log /var/log/nginx/access.log main;

    # 10 req/s per IP，所有端點共用一個 zone；各 location 自己調 burst。
    limit_req_zone $binary_remote_addr zone=gitlab_api:10m rate=10r/s;
    limit_req_status 429;

    upstream gitlab {
        server ${GITLAB_HOST}:443;
    }

    # 上游 TLS 驗證。這四行漏掉，代理對 GitLab 就是不驗憑證——
    # 你把憑證從 agent 手上收走，卻在代理這一段自己開了一個中間人的門。
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_server_name on;
    proxy_ssl_name ${GITLAB_HOST};

    server {
        listen 5678;
        server_name localhost;

        # 發佈報告的 body 會比一般請求大，但不該無限大。
        client_max_body_size 10m;

        proxy_set_header Host ${GITLAB_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 憑證在這裡蓋章。呼叫端（skill、curl）不需要、也不應該持有 token。
        #
        # 為什麼可以設在 server 層讓所有 location 繼承：這份設定只代理 GitLab API，
        # 每一條 location 的授權方式都一樣。等到哪天要連 git clone 也走這個代理，
        # 這行就得搬進各自的 location——git transport 不吃 PRIVATE-TOKEN 也不吃
        # Bearer，只吃 Basic，繼承下去會讓 git 全部 401。
        proxy_set_header PRIVATE-TOKEN "${GITLAB_TOKEN}";

        # 呼叫端若自己帶了 Authorization，不要轉給上游。
        # 代理的意義是「只有這裡有憑證」，那就不該有第二個來源。
        proxy_set_header Authorization "";

        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 10s;

        # GitLab 對「專案改名、大小寫不符」會回絕對 URL 的 301，呼叫端會老實跟著跳，
        # 跳出代理直連 GitLab——而那條路是沒有憑證的。改寫回代理自己。
        proxy_redirect https://${GITLAB_HOST}/ /;

        # =============================================
        # 健康檢查
        # =============================================
        # 不經上游，所以沒有 token 也答得出來。它回答的是「代理在不在」，
        # 不是「憑證對不對」。
        location = /ping {
            default_type application/json;
            return 200 '{"result": true, "data": {}}';
        }

        # =============================================
        # 白名單：只有 skill 真的會呼叫的端點
        # =============================================
        # 對照 skills/nathan-code-review/scripts/gitlab_api.py 的七個子指令。
        # 加端點時，這裡與該 skill 的 references/gitlab-api.md 要一起改。
        #
        # 兩個 nginx 的坑，寫在前面免得踩：
        #   1. location ~ 的 regex 不能用大括號量詞。`[0-9a-f]{32}` 會讓設定解析器
        #      把 `{` 當成 block 開頭，啟動時報 unknown directive。所以用 `+`。
        #   2. nginx 會先把 %2F 解碼再比對 location。所以 project 那一段用 `.+`
        #      就同時涵蓋數字 id 與 URL-encoded 的完整路徑，不必寫兩條；
        #      但也因此每條 regex 都要用結尾的 `$` 錨死，否則會互相吃掉。

        # 1) GET /api/v4/user
        #    gitlab_api.py whoami：確認 token 有效、知道自己是誰。
        location = /api/v4/user {
            limit_except GET { deny all; }
            limit_req zone=gitlab_api burst=3 nodelay;
            proxy_pass https://gitlab;
        }

        # 2) GET /api/v4/projects/{id}/merge_requests/{iid}
        #    gitlab_api.py mr：取回標題、說明、來源與目標分支。
        location ~ ^/api/v4/projects/.+/merge_requests/[0-9]+$ {
            limit_except GET { deny all; }
            limit_req zone=gitlab_api burst=5 nodelay;
            proxy_pass https://gitlab;
        }

        # 3) GET /api/v4/projects/{id}/uploads/{secret}/{filename}
        #    gitlab_api.py attachments：下載 MR 說明裡的附件（需求規格、截圖）。
        #    回傳 binary。{secret} 是 hex、{filename} 可能含中文（URL-encoded）。
        location ~ ^/api/v4/projects/.+/uploads/[0-9a-f]+/.+$ {
            limit_except GET { deny all; }
            limit_req zone=gitlab_api burst=3 nodelay;
            proxy_pass https://gitlab;
        }

        # 4) GET / POST /api/v4/projects/{id}/merge_requests/{iid}/discussions
        #    GET ：gitlab_api.py discussions——再次審查時取回作者的回覆（有分頁）。
        #    POST：gitlab_api.py post-report——把報告發成一個可被回覆的討論串。
        #    同一條 regex 只能有一個 location，所以 GET / POST 合併用 limit_except。
        location ~ ^/api/v4/projects/.+/merge_requests/[0-9]+/discussions$ {
            limit_except GET POST { deny all; }
            limit_req zone=gitlab_api burst=5 nodelay;
            proxy_pass https://gitlab;
        }

        # 5) GET /api/v4/projects/{id}/merge_requests/{iid}/discussions/{discussion_id}
        #    gitlab_api.py discussion：已知 discussion_id 時的省錢版，
        #    只讀那一串的回覆，不用整包列出。
        location ~ ^/api/v4/projects/.+/merge_requests/[0-9]+/discussions/[0-9a-f]+$ {
            limit_except GET { deny all; }
            limit_req zone=gitlab_api burst=5 nodelay;
            proxy_pass https://gitlab;
        }

        # 6) POST /api/v4/projects/{id}/merge_requests/{iid}/discussions/{id}/notes
        #    gitlab_api.py reply：回覆作者。對外且不可逆，skill 規定要人類確認過才發。
        location ~ ^/api/v4/projects/.+/merge_requests/[0-9]+/discussions/[0-9a-f]+/notes$ {
            limit_except POST { deny all; }
            limit_req zone=gitlab_api burst=3 nodelay;
            proxy_pass https://gitlab;
        }

        # =============================================
        # 其餘一律拒絕
        # =============================================
        # 白名單模式的地板：沒列到的就是不准。這一段必須留在最後，
        # 排到前面去的話整份白名單就形同虛設。
        location / {
            default_type application/json;
            return 403 '{"error": "Forbidden: endpoint not whitelisted"}';
        }
    }
}
