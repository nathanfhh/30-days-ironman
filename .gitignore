# macOS Finder metadata — this directory is shared with a macOS host, so these
# reappear on their own.
.DS_Store

# uv's virtualenv. Recreated by `uv sync`; never shared.
.venv/

# uv.lock is deliberately NOT ignored. The dev toolchain (pytest, pydantic) is
# what the test suite runs against, and a lockfile is what makes "the tests pass
# on my machine" mean something on someone else's machine. The skills' own
# scripts pin their runtime dependencies inline (PEP 723) and do not read it.

# Tooling caches.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 代理的 .env 裡有 GitLab PAT，絕不進版控。
gitlab-proxy/.env

# drawio 匯出的 PNG。衍生物：`docs/export-diagrams.sh` 一行重生，而每改一次圖
# 就多一版好幾 MB 的二進位檔。要嵌文章時再產。
diagram-png/

# draw.io 開檔時留下的自動備份（`.$檔名.bkp`），不是產物也不是原稿
.$*.bkp

# coverage.py 資料檔
.coverage

# 關聯圖的產物由 site/build.py 產生，CI 會重做
site/dist/

# embed.py 的產物含向量、約 5 MB，留在本機給下一次 --reuse；embed_analyze 的健檢報告也不進版控。
# 進 repo 的是它們算出來的 site/data/embed.json。
embeddings*.json
audit*.json
