          <mxGeometry height="130" width="252" x="44" y="226" as="geometry" />
        </mxCell>
        <mxCell id="hl_h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;Phase 0.5&lt;/b&gt;&lt;br&gt;intent" vertex="1">
