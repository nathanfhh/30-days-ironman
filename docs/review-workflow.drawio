        <mxCell id="hl_b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;spacingTop=8;" value="三題快問：該不該做、該不該在這個 MR、該不該現在。&lt;br&gt;存疑不擋審查，但一定寫進報告——那是人的決定。" vertex="1">
          <mxGeometry height="130" width="252" x="322" y="226" as="geometry" />
