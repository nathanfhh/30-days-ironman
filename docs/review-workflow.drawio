        </mxCell>
        <mxCell id="hl_sub" parent="1" style="text;html=1;fontSize=14;align=left;fontColor=#6b7280;" value="六個 Phase，每一個只回答一個問題。順序不能對調：每一步都在替下一步限縮範圍。" vertex="1">
          <mxGeometry height="24" width="1400" x="44" y="80" as="geometry" />
