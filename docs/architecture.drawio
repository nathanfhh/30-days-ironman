        </mxCell>
        <mxCell id="p2-pA" value="nginx 代理（A 的）&lt;br&gt;alias：gitlab-proxy&lt;br&gt;注入 A 的 PAT・端點白名單・限流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="420" y="650" width="240" height="130" as="geometry" />
