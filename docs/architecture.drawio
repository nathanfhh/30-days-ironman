  <diagram id="pty-highlevel" name="claude-pty（一頁版）">
    <mxGraphModel dx="534" dy="283" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1526" pageHeight="538" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pty-highlevel_t" parent="1" style="text;html=1;fontSize=24;fontStyle=1;align=left;fontColor=#111827;" value="claude-pty — 一場 session 就是一顆容器" vertex="1">
          <mxGeometry height="34" width="1400" x="44" y="36" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_s" parent="1" style="text;html=1;fontSize=14;align=left;fontColor=#6b7280;" value="瀏覽器開的終端，背後是一顆真的容器。四個角色，各自只做一件事。" vertex="1">
          <mxGeometry height="24" width="1458" x="44" y="74" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_h0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;邊界&lt;/b&gt;&lt;br&gt;nginx" vertex="1">
          <mxGeometry height="52" width="340" x="44" y="132" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_q0" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#1e40af;" value="&lt;b&gt;唯一對外口&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="340" x="44" y="194" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;align=center;spacingLeft=12;spacingRight=10;verticalAlign=middle;spacingTop=8;" value="全系統只發布這一個 port。&lt;br&gt;控制流與終端資料流在這裡就分開，&lt;br&gt;之後不再交會。" vertex="1">
          <mxGeometry height="140" width="340" x="44" y="226" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;決策&lt;/b&gt;&lt;br&gt;control plane" vertex="1">
          <mxGeometry height="52" width="340" x="410" y="132" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_q1" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#1e40af;" value="&lt;b&gt;開一場、關一場&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="340" x="410" y="194" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;align=center;spacingLeft=12;spacingRight=10;verticalAlign=middle;spacingTop=8;" value="帳號、授權、生命週期。&lt;br&gt;它不碰終端的資料，你敲的每一個鍵&lt;br&gt;都繞過它直接到 ttyd。" vertex="1">
          <mxGeometry height="140" width="340" x="410" y="226" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_a1" edge="1" parent="1" style="edgeStyle=none;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="386" y="158" as="sourcePoint" />
            <mxPoint x="408" y="158" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pty-highlevel_h2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;仲裁&lt;/b&gt;&lt;br&gt;SQLite" vertex="1">
          <mxGeometry height="52" width="340" x="776" y="132" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_q2" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#1e40af;" value="&lt;b&gt;唯一的事實&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="340" x="776" y="194" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;align=center;spacingLeft=12;spacingRight=10;verticalAlign=middle;spacingTop=8;" value="誰擁有哪一場、port 給了誰、租約在誰手上。&lt;br&gt;互斥不靠約定，靠這裡的交易。" vertex="1">
          <mxGeometry height="140" width="340" x="776" y="226" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_a2" edge="1" parent="1" style="edgeStyle=none;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="752" y="158" as="sourcePoint" />
            <mxPoint x="774" y="158" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pty-highlevel_h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;收斂&lt;/b&gt;&lt;br&gt;reconciler" vertex="1">
          <mxGeometry height="52" width="340" x="1142" y="132" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_q3" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#1e40af;" value="&lt;b&gt;把帳面校正回現實&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="340" x="1142" y="194" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;align=center;spacingLeft=12;spacingRight=10;verticalAlign=middle;spacingTop=8;" value="每一輪比對 DB 與 dockerd 的落差：&lt;br&gt;孤兒容器、過期代理、沒人用的終端，&lt;br&gt;一輪一輪收乾淨。" vertex="1">
          <mxGeometry height="140" width="340" x="1142" y="226" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_a3" edge="1" parent="1" style="edgeStyle=none;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1118" y="158" as="sourcePoint" />
            <mxPoint x="1140" y="158" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pty-highlevel_n" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;dashed=1;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;" value="&lt;b&gt;隔離做在哪一層&lt;/b&gt;　每個使用者一張自己的 docker network，他所有的 session 只住在那張網上。跨使用者在拓撲上就沒有那條路——不是靠容器裡的防火牆擋，那擋不住完全開放的網路模式。" vertex="1">
          <mxGeometry height="52" width="1438" x="44" y="400" as="geometry" />
        </mxCell>
        <mxCell id="pty-highlevel_f" parent="1" style="text;html=1;fontSize=12;align=left;fontColor=#9ca3af;" value="完整拓撲見另一頁「claude-pty 放大」。對照：claude-pty/docs/adr/0016-per-user-gitlab-proxy.md" vertex="1">
          <mxGeometry height="22" width="1438" x="44" y="468" as="geometry" />
        </mxCell>
      </root>
