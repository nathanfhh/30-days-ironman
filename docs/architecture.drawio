          <mxGeometry x="1120" y="650" width="240" height="130" as="geometry" />
        </mxCell>
        <!-- isolation note -->
        <mxCell id="p2-isonote" value="alias 相同・network 不同 → A 的 session 解析到的永遠是 A 的代理，看不到 B 的；&lt;br&gt;限流桶因此對得上「人」（server/user_proxy.py・server/gitlab_proxy.py・ADR 0016）" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="440" height="60" as="geometry" />
