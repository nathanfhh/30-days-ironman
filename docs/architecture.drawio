        </mxCell>
        <mxCell id="p2-nginx-rb" value="路由 B：/session/&lt;sid&gt;/ → auth_request 子請求&lt;br&gt;通過才 proxy 到 ttyd（終端資料流，不經 Flask）" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="115" width="310" height="45" as="geometry" />
        </mxCell>
