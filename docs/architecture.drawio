          <mxGeometry x="60" y="560" width="630" height="310" as="geometry" />
        </mxCell>
        <mxCell id="p2-sA1" value="session 容器 A-1&lt;br&gt;entrypoint.sh → claude" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
