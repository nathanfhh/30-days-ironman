        <mxCell id="p2-flask" value="control plane（Flask）&lt;br&gt;帳號／授權／生命週期" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
