  <diagram id="skill-architecture" name="Skill 架構：漸進式揭露">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="nathan-code-review — Skill 架構（漸進式揭露 / progressive disclosure）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="18" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="SKILL.md 約 11.9 KB，於 Skill 觸發時載入；其餘 73 KB 依 Phase 按需載入。模型不是「讀完整份 skill 再工作」，是「走到哪一步、才讀那一步需要的那一份」。" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="1400" height="22" as="geometry" />
        </mxCell>
        <!-- ===== 觸發層 ===== -->
        <mxCell id="trigger" value="使用者請求&#xa;（MR 連結／「幫我 review」／無參數）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="96" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="fm" value="frontmatter&#xa;&lt;b&gt;description&lt;/b&gt;&#xa;（唯一「永遠在 context 裡」的東西）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="96" width="230" height="56" as="geometry" />
        </mxCell>
