          <mxGeometry height="52" width="340" x="410" y="132" as="geometry" />
        </mxCell>
        <mxCell id="skill-highlevel_q1" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#1e40af;" value="&lt;b&gt;走到才讀&lt;/b&gt;" vertex="1">
