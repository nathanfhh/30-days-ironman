        <mxCell id="skill-highlevel_b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;spacingTop=8;" value="六支 subagent，各自獨立 context。&lt;br&gt;掃描器吐出的原始 JSON 從頭到尾不進主線程。" vertex="1">
