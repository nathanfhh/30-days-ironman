          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note_fm" value="⚠ description 寫壞 = skill 永遠不會被叫起來。&#xa;它不是說明文字，是&lt;b&gt;路由條件&lt;/b&gt;。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#b91c1c;" vertex="1" parent="1">
