{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }]
  },
  "env": { "browser": true, "es2022": true },
  "ignorePatterns": ["dist", "node_modules"]
}
